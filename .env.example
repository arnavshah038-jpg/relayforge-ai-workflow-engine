DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relayforge
# at least 32 random characters, the app refuses to start otherwise:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# leave empty to use the built-in keyword classifier (no API calls, no cost)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# optional knobs, these are the defaults
# MAX_REFUND=50000
# STEP_MAX_ATTEMPTS=4
# LEASE_SECONDS=60
# SWEEP_INTERVAL_S=30
# LOGIN_MAX_FAILURES=5
# demo only: 0.3 makes the fake payment provider fail 30% of the time
# GATEWAY_FAILURE_RATE=0
